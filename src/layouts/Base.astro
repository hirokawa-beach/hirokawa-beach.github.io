---
import '../styles/global.css';
interface Props { title: string; description?: string; active?: string; }
const { title, description = 'Hirokawa Beachの個人サイト。制作物・技術ブログ・開発記録を公開しています。', active } = Astro.props;
const nav = [{ label: 'Projects', href: '/projects/', id: 'projects' },{ label: 'Blog', href: '/blog/', id: 'blog' },{ label: 'About', href: '/about/', id: 'about' },{ label: 'Status', href: '/status/', id: 'status' }];
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d1117" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{title === 'Home' ? 'Hirokawa Beach | hb283.dev' : title + ' | hb283.dev'}</title>
  </head>
  <body>
    <header class="site-header">
      <nav class="wrap nav" aria-label="メインナビゲーション">
        <a class="brand" href="/">hb283<b>.dev</b></a>
        <div class="nav-links">{nav.map(item => <a href={item.href} aria-current={active === item.id ? 'page' : undefined}>{item.label}</a>)}</div>
      </nav>
    </header>
    <main class="wrap"><slot /></main>
    <footer class="footer"><div class="wrap footer-inner"><span>© {new Date().getFullYear()} Hirokawa Beach</span><span>Built with Astro · <a href="https://github.com/hirokawa-beach" target="_blank" rel="noopener noreferrer">GitHub ↗</a></span></div></footer>
  </body>
</html>
