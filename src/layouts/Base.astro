---
import Icon from '../components/Icon.astro';
import AnimatedBrand from '../components/AnimatedBrand.astro';
import '../styles/global.css';
import socialImage from '../assets/hb283-ogp.png';
import { siteMetadata } from '../data/site';
interface Props { title: string; description?: string; active?: string; ogType?: 'website' | 'article'; }
const {
  title,
  description = siteMetadata.description,
  active,
  ogType = 'website'
} = Astro.props;
const pageTitle = title === 'Home' ? siteMetadata.title : `${title} | hb283.dev`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(socialImage.src, Astro.site);
const navigation = [
  { label: 'ホーム', href: '/', id: 'home' },
  { label: '制作物', href: '/projects/', id: 'projects' },
  { label: 'ブログ', href: '/blog/', id: 'blog' },
  { label: '稼働状況', href: '/status/', id: 'status' }
];
---
<!doctype html>
<html lang="ja" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f8f6" />
    <link rel="canonical" href={canonicalURL} />
    <title>{pageTitle}</title>
    <meta property="og:site_name" content={siteMetadata.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(socialImage.width)} />
    <meta property="og:image:height" content={String(socialImage.height)} />
    <meta property="og:image:alt" content={siteMetadata.imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={siteMetadata.imageAlt} />
    <script is:inline>
      try {
        if (localStorage.getItem('hb283-theme') === 'dark') document.documentElement.dataset.theme = 'dark';
      } catch (_) { /* Storage may be disabled; use the light default. */ }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">本文へ移動</a>
    <header class="site-header">
      <nav class="wrap nav" aria-label="メインナビゲーション">
        <AnimatedBrand />
        <button class="nav-toggle" type="button" data-navigation-toggle hidden aria-label="メニューを開く" aria-expanded="false" aria-controls="site-navigation">
          <span class="nav-toggle-open"><Icon name="menu" /></span>
          <span class="nav-toggle-close"><Icon name="close" /></span>
        </button>
        <div class="nav-links" id="site-navigation">
          {navigation.map(item => <a href={item.href} aria-current={active === item.id ? 'page' : undefined}>{item.label}</a>)}
        </div>
        <button class="theme-toggle" type="button" id="theme-toggle" aria-label="ダークモードに切り替える" aria-pressed="false" title="テーマを切り替える">
          <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z"/></svg>
          <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
      </nav>
    </header>
    <main class="wrap" id="main"><slot /></main>
    <footer class="footer">
      <div class="wrap footer-inner">
        <span>© {new Date().getFullYear()} Hirokawa Beach</span>
        <div class="footer-links">
          <a href="https://github.com/hirokawa-beach" target="_blank" rel="noopener noreferrer">GitHub<Icon name="external" /></a>
          <a href="/#profile">プロフィール</a>
        </div>
      </div>
    </footer>
    <script>
      import '../scripts/navigation';
    </script>
    <script is:inline>
      (() => {
        const button = document.getElementById('theme-toggle');
        const root = document.documentElement;
        const meta = document.querySelector('meta[name="theme-color"]');
        if (!button) return;
        const sync = () => {
          const dark = root.dataset.theme === 'dark';
          button.setAttribute('aria-pressed', String(dark));
          button.setAttribute('aria-label', dark ? 'ライトモードに切り替える' : 'ダークモードに切り替える');
          if (meta) meta.setAttribute('content', dark ? '#242629' : '#f8f8f6');
        };
        sync();
        button.addEventListener('click', () => {
          const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try { localStorage.setItem('hb283-theme', next); } catch (_) { /* Ignore storage restrictions. */ }
          sync();
        });
      })();
    </script>
  </body>
</html>
