---
import '../styles/global.css';
interface Props { title: string; description?: string; active?: string; }
const {
  title,
  description = 'ひろかわびーちの個人サイト。制作物・技術ブログ・開発記録を公開しています。',
  active
} = Astro.props;
const navigation = [
  { label: '制作物', href: '/projects/', id: 'projects' },
  { label: 'ブログ', href: '/blog/', id: 'blog' },
  { label: 'プロフィール', href: '/about/', id: 'about' },
  { label: '稼働状況', href: '/status/', id: 'status' }
];
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0e1217" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{title === 'Home' ? 'ひろかわびーち | hb283.dev' : title + ' | hb283.dev'}</title>
  </head>
  <body>
    <header class="site-header">
      <nav class="wrap nav" aria-label="メインナビゲーション">
        <a class="brand" href="/" aria-label="ホームに戻る">hb283<span class="brand-tld">.dev</span></a>
        <div class="nav-links">
          {navigation.map(item => <a href={item.href} aria-current={active === item.id ? 'page' : undefined}>{item.label}</a>)}
        </div>
      </nav>
    </header>
    <main class="wrap" id="main"><slot /></main>
    <footer class="footer">
      <div class="wrap footer-inner">
        <span>© {new Date().getFullYear()} Hirokawa Beach</span>
        <span>Astro / TypeScript · <a href="https://github.com/hirokawa-beach" target="_blank" rel="noopener noreferrer">GitHub ↗</a></span>
      </div>
    </footer>
  </body>
</html>
