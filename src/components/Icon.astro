---
import external from '@phosphor-icons/core/assets/regular/arrow-square-out.svg?raw';
import right from '@phosphor-icons/core/assets/regular/arrow-right.svg?raw';
import left from '@phosphor-icons/core/assets/regular/arrow-left.svg?raw';
import rss from '@phosphor-icons/core/assets/regular/rss.svg?raw';
import menu from '@phosphor-icons/core/assets/regular/list.svg?raw';
import close from '@phosphor-icons/core/assets/regular/x.svg?raw';
const icons = { external, right, left, rss, menu, close };
interface Props { name: keyof typeof icons; }
const { name } = Astro.props;
---
<span class={`ui-icon ui-icon--${name}`} aria-hidden="true"><Fragment set:html={icons[name]} /></span>
