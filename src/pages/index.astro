---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 2);
const featured = projects[0];
---
<Base title="Home">
  <section class="hero" aria-label="自己紹介">
    <div class="hero-copy">
      <h1>ひろかわびーち</h1>
      <p class="hero-headline">Webアプリやツールを作っています。</p>
      <p class="hero-description">個人開発の制作物や、開発中に試したことをまとめています。Web開発を中心に、LinuxやRaspberry Piなどにも取り組んでいます。</p>
      <div class="hero-links">
        <a class="button button-primary" href="/projects/">制作物を見る <span aria-hidden="true">→</span></a>
        <a class="text-link" href="https://github.com/hirokawa-beach" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      </div>
    </div>
    <aside class="hero-profile" aria-labelledby="profile-heading">
      <div class="profile-heading">
        <span class="profile-symbol" aria-hidden="true">
          <svg class="line-icon" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M5 21v-2a7 7 0 0 1 14 0v2"/></svg>
        </span>
        <div>
          <h2 id="profile-heading">プロフィール</h2>
          <p>Hirokawa Beach</p>
        </div>
      </div>
      <p class="profile-description">Webアプリや開発ツールの個人制作を中心に、身近な課題を解決するものを作っています。</p>
      <ul class="profile-fields">
        <li>
          <svg class="line-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m8 8-4 4 4 4m8-8 4 4-4 4M14 4l-4 16"/></svg>
          <span>Web開発・ソフトウェア制作</span>
        </li>
        <li>
          <svg class="line-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M9 9h6v6H9zM9 1v3m6-3v3M9 20v3m6-3v3M1 9h3m-3 6h3m16-6h3m-3 6h3"/></svg>
          <span>Linux・Raspberry Pi・電子工作</span>
        </li>
      </ul>
      <div class="profile-actions">
        <a href="/about/">詳しいプロフィール →</a>
        <a href="https://github.com/hirokawa-beach" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12a10 10 0 0 0 6.84 9.5c.5.1.68-.21.68-.48v-1.69c-2.78.6-3.37-1.18-3.37-1.18-.45-1.14-1.1-1.44-1.1-1.44-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.64.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02A9.6 9.6 0 0 1 12 6.65c.85 0 1.7.11 2.5.34 1.9-1.29 2.74-1.02 2.74-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.33 4.69-4.56 4.94.36.32.68.95.68 1.92v2.86c0 .27.18.59.69.48A10 10 0 0 0 22 12c0-5.52-4.48-10-10-10Z"/></svg>
          GitHub ↗
        </a>
      </div>
    </aside>
  </section>

  <section class="section" aria-labelledby="projects-heading">
    <div class="section-head">
      <h2 id="projects-heading">制作物</h2>
      <a href="/projects/">すべて見る →</a>
    </div>
    <article class="spotlight" aria-labelledby="spotlight-heading">
      <div class="spotlight-thumb">
        <img src="/studycopi-guide/assets/today.webp" alt="StudyCoPiの学習管理画面" width="900" height="530" loading="lazy" decoding="async" />
      </div>
      <div>
        <span class="spotlight-kind">Web App · PWA</span>
        <h3 id="spotlight-heading">{featured.name}</h3>
        <p>{featured.description}</p>
        <div class="spotlight-links">
          {featured.href && <a href={featured.href} target="_blank" rel="noopener noreferrer">公開サイト ↗</a>}
          {featured.github && <a href={featured.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>}
        </div>
      </div>
    </article>
    <div class="project-list">{projects.slice(1).map(project => <ProjectCard project={project} />)}</div>
  </section>

  <section class="blog-home" aria-labelledby="blog-heading">
    <div class="section-head">
      <h2 id="blog-heading">ブログ</h2>
      <a href="/blog/">記事一覧 →</a>
    </div>
    <div class="post-list">
      {posts.map(post => <article class="post-row">
        <time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('ja-JP')}</time>
        <h2><a href={'/blog/' + post.id + '/'}>{post.data.title} →</a></h2>
        <p>{post.data.description}</p>
      </article>)}
    </div>
  </section>
</Base>
