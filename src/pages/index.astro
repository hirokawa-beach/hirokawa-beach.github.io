---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 2);
const featured = projects[0];
---
<Base title="Home">
  <section class="hero" aria-label="自己紹介">
    <div class="hero-copy">
      <h1>ひろかわびーち</h1>
      <p class="hero-headline">Webアプリやツールを作っています。</p>
      <p class="hero-description">個人開発の制作物や、開発中に試したことをまとめています。Web開発を中心に、LinuxやRaspberry Piなどにも取り組んでいます。</p>
      <div class="hero-links">
        <a class="button button-primary" href="/projects/">制作物を見る <span aria-hidden="true">→</span></a>
        <a class="text-link" href="https://github.com/hirokawa-beach" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      </div>
    </div>
    <article class="feature" aria-label="代表作 StudyCoPi">
      <div class="feature-visual">
        <div class="feature-window">
          <div class="window-top" aria-hidden="true"><span></span><span></span><span></span></div>
          <img src="/studycopi-guide/assets/today.webp" alt="StudyCoPiの学習管理画面" width="900" height="530" loading="eager" decoding="async"/>
        </div>
      </div>
      <div class="feature-info">
        <h2 class="feature-title">{featured.name}</h2>
        <p>{featured.description}</p>
        <div class="feature-footer">
          <span class="feature-note">Web App · PWA</span>
          {featured.href && <a class="text-link" href={featured.href} target="_blank" rel="noopener noreferrer">アプリを開く ↗</a>}
        </div>
      </div>
    </article>
  </section>
  <section class="section" aria-labelledby="projects-heading">
    <div class="section-head">
      <h2 id="projects-heading">その他の制作物</h2>
      <a href="/projects/">すべて見る →</a>
    </div>
    <div class="project-list">{projects.slice(1).map(project => <ProjectCard project={project} />)}</div>
  </section>
  <div class="home-end">
    <section aria-labelledby="blog-heading">
      <div class="section-head">
        <h2 id="blog-heading">ブログ</h2>
        <a href="/blog/">記事一覧 →</a>
      </div>
      <div class="post-list">
        {posts.map(post => <article class="post-row">
          <time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('ja-JP')}</time>
          <h2><a href={'/blog/' + post.id + '/'}>{post.data.title} →</a></h2>
          <p>{post.data.description}</p>
        </article>)}
      </div>
    </section>
    <section aria-labelledby="about-heading">
      <div class="section-head"><h2 id="about-heading">このサイトについて</h2></div>
      <div class="home-info">
        <p>制作したアプリやツールの公開、技術的な試行錯誤の記録に使っています。</p>
        <p>開発環境や興味のある分野についても紹介しています。</p>
        <a href="/about/">プロフィールを見る →</a>
      </div>
    </section>
  </div>
</Base>
