---
import Base from '../layouts/Base.astro';
import { profileAvatar } from '../data/profileAvatar';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 2);
const featured = projects[0];
const featuredScreens = [
  { label: '今日', title: '今日の学習', src: '/studycopi-guide/assets/today.webp', width: 780, height: 1688 },
  { label: '統計', title: '学習の統計', src: '/studycopi-guide/assets/stats.webp', width: 768, height: 1664 },
  { label: '週間', title: '週間の予定', src: '/studycopi-guide/assets/timetable.webp', width: 2048, height: 1536 }
];
---
<Base title="Home">
  <section class="hero" aria-label="自己紹介">
    <div class="hero-copy">
      <h1>ひろかわびーち</h1>
      <p class="hero-headline">Web/デスクトップアプリを個人開発したり、架空鉄道を考えたりしています。</p>
      <p class="hero-description">学習管理アプリや地図サービス、Discord Botなどを開発しています。このサイトでは制作物や開発の記録を公開しています。</p>
      <div class="hero-links">
        <a class="button button-primary" href="/projects/">制作物を見る <span aria-hidden="true">→</span></a>
        <a class="text-link" href="https://github.com/hirokawa-beach" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      </div>
    </div>
    <aside class="hero-profile" id="profile" aria-labelledby="profile-heading">
      <div class="profile-heading">
        <img class="profile-avatar" src={profileAvatar} alt="ひろかわびーちのアイコン" width="88" height="88" decoding="async" />
        <div>
          <h2 id="profile-heading">プロフィール</h2>
        </div>
      </div>
      <p class="profile-description">学生です。ソフトウェア開発のほか、電子工作やLinuxにも触れています。</p>
      <h3 class="profile-fields-title">興味のある分野</h3>
      <ul class="profile-fields">
        <li>
          <svg class="line-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m8 8-4 4 4 4m8-8 4 4-4 4M14 4l-4 16"/></svg>
          <span>Python, C#, Qt, HTML/CSS/JS</span>
        </li>
        <li>
          <svg class="line-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M9 9h6v6H9zM9 1v3m6-3v3M9 20v3m6-3v3M1 9h3m-3 6h3m16-6h3m-3 6h3"/></svg>
          <span>Raspberry Pi・Arduino, Linux</span>
        </li>
      </ul>
      <p class="profile-activity">Wplace沖ノ鳥島開発の技術局長（2025年8月〜）としても活動しています。</p>
      <div class="profile-actions">
        <a href="https://github.com/hirokawa-beach" target="_blank" rel="noopener noreferrer" aria-label="GitHubを開く">
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12a10 10 0 0 0 6.84 9.5c.5.1.68-.21.68-.48v-1.69c-2.78.6-3.37-1.18-3.37-1.18-.45-1.14-1.1-1.14-1.14-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.64.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02A9.6 9.6 0 0 1 12 6.65c.85 0 1.7.11 2.5.34 1.9-1.29 2.74-1.02 2.74-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.33 4.69-4.56 4.94.36.32.68.95.68 1.92v2.86c0 .27.18.59.69.48A10 10 0 0 0 22 12c0-5.52-4.48-10-10-10Z"/></svg>
          GitHub ↗
        </a>
        <a href="https://twitter.com/Hirokawa_beach" target="_blank" rel="noopener noreferrer">X ↗</a>
        <a href="https://www.youtube.com/@hirokawabeach_283" target="_blank" rel="noopener noreferrer">YouTube ↗</a>
      </div>
    </aside>
  </section>

  <section class="section" aria-labelledby="projects-heading">
    <div class="section-head">
      <h2 id="projects-heading">制作物</h2>
      <a href="/projects/">すべて見る →</a>
    </div>
    <article class="spotlight" aria-labelledby="spotlight-heading">
      <div class="spotlight-preview" data-flip-preview>
        <div class="flip-stage" aria-hidden="true">
          {featuredScreens.map((screen, index) => (
            <div class="flip-window" data-flip-window data-position={index}>
              <div class="flip-titlebar">{featured.name}<span>{screen.title}</span></div>
              <img src={screen.src} alt="" width={screen.width} height={screen.height} loading="lazy" decoding="async" />
            </div>
          ))}
        </div>
        <div class="flip-controls" role="group" aria-label="StudyCoPiの表示画面" hidden>
          {featuredScreens.map((screen, index) => (
            <button type="button" data-flip-select={index} data-screen-title={screen.title} data-screen-src={screen.src} aria-pressed={index === 0}>
              {screen.label}
            </button>
          ))}
        </div>
        <p class="flip-caption">
          <span role="status" aria-atomic="true" data-flip-status>今日の学習（画面の一部）</span>
          <a href={featuredScreens[0].src} target="_blank" rel="noopener noreferrer" data-flip-link aria-label="画面を開く ↗（今日の学習、新しいタブ）">画面を開く ↗</a>
        </p>
      </div>
      <div>
        <span class="spotlight-kind">Web App · PWA</span>
        <h3 id="spotlight-heading">{featured.name}</h3>
        <p>{featured.description}</p>
        <div class="spotlight-links">
          {featured.href && <a href={featured.href} target="_blank" rel="noopener noreferrer">公開サイト ↗</a>}
          {featured.github && <a href={featured.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>}
        </div>
      </div>
    </article>
    <div class="project-list">{projects.slice(1).map(project => <ProjectCard project={project} />)}</div>
  </section>

  <section class="blog-home" aria-labelledby="blog-heading">
    <div class="section-head">
      <h2 id="blog-heading">ブログ</h2>
      <a href="/blog/">記事一覧 →</a>
    </div>
    <div class="post-list">
      {posts.map(post => <article class="post-row">
        <time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('ja-JP')}</time>
        <h2><a href={'/blog/' + post.id + '/'}>{post.data.title} →</a></h2>
        <p>{post.data.description}</p>
      </article>)}
    </div>
  </section>
</Base>

<script>
  document.querySelectorAll<HTMLElement>('[data-flip-preview]').forEach(preview => {
    const windows = [...preview.querySelectorAll<HTMLElement>('[data-flip-window]')];
    const controls = preview.querySelector<HTMLElement>('.flip-controls');
    const buttons = [...preview.querySelectorAll<HTMLButtonElement>('[data-flip-select]')];
    const status = preview.querySelector<HTMLElement>('[data-flip-status]');
    const link = preview.querySelector<HTMLAnchorElement>('[data-flip-link]');
    if (!controls || !status || !link || buttons.length !== windows.length || buttons.length < 2) return;

    const select = (selected: number) => {
      windows.forEach((window, index) => {
        window.dataset.position = String((index - selected + windows.length) % windows.length);
      });
      buttons.forEach((button, index) => button.setAttribute('aria-pressed', String(index === selected)));
      const { screenTitle, screenSrc } = buttons[selected].dataset;
      status.textContent = `${screenTitle}（画面の一部）`;
      link.href = screenSrc!;
      link.setAttribute('aria-label', `画面を開く ↗（${screenTitle}、新しいタブ）`);
    };

    buttons.forEach((button, index) => {
      button.addEventListener('click', () => select(index));
      button.addEventListener('keydown', event => {
        let next: number;
        switch (event.key) {
          case 'ArrowRight': next = (index + 1) % buttons.length; break;
          case 'ArrowLeft': next = (index - 1 + buttons.length) % buttons.length; break;
          case 'Home': next = 0; break;
          case 'End': next = buttons.length - 1; break;
          default: return;
        }
        event.preventDefault();
        buttons[next].focus();
        select(next);
      });
    });
    controls.hidden = false;
  });
</script>
