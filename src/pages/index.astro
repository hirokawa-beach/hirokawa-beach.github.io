---
import Icon from '../components/Icon.astro';
import GithubMark from '../components/GithubMark.astro';
import Base from '../layouts/Base.astro';
import { profileAvatar } from '../data/profileAvatar';
import { projects } from '../data/projects';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 2);
---
<Base title="Home">
  <section class="hero" aria-label="自己紹介">
    <div class="hero-copy">
      <h1>ひろかわびーち</h1>
      <p class="hero-headline">Web/デスクトップアプリを個人開発したり、架空鉄道を考えたりしています。</p>
      <p class="hero-description">学習管理アプリや地図サービス、Discord Botなどを開発しています。このサイトでは制作物や開発の記録を公開しています。</p>
      <div class="hero-links">
        <a class="button button-primary" href="/projects/">制作物を見る <Icon name="right" /></a>
        <a class="text-link" href="https://github.com/hirokawa-beach" target="_blank" rel="noopener noreferrer">GitHub<Icon name="external" /></a>
      </div>
    </div>
    <aside class="hero-profile" id="profile" aria-labelledby="profile-heading">
      <div class="profile-heading">
        <img class="profile-avatar" src={profileAvatar} alt="ひろかわびーちのアイコン" width="88" height="88" decoding="async" />
        <div>
          <h2 id="profile-heading">プロフィール</h2>
        </div>
      </div>
      <p class="profile-description">学生です。ソフトウェア開発のほか、電子工作やLinuxにも触れています。</p>
      <h3 class="profile-fields-title">興味のある分野</h3>
      <ul class="profile-fields">
        <li>
          <svg class="line-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m8 8-4 4 4 4m8-8 4 4-4 4M14 4l-4 16"/></svg>
          <span>Python, C#, Qt, HTML/CSS/JS</span>
        </li>
        <li>
          <svg class="line-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M9 9h6v6H9zM9 1v3m6-3v3M9 20v3m6-3v3M1 9h3m-3 6h3m16-6h3m-3 6h3"/></svg>
          <span>Raspberry Pi・Arduino, Linux</span>
        </li>
      </ul>
      <p class="profile-activity">Wplace沖ノ鳥島開発の技術局長（2025年8月〜）としても活動しています。</p>
      <div class="profile-actions">
        <a href="https://github.com/hirokawa-beach" target="_blank" rel="noopener noreferrer" aria-label="GitHubを開く">
          <GithubMark />
          GitHub<Icon name="external" />
        </a>
        <a href="https://twitter.com/Hirokawa_beach" target="_blank" rel="noopener noreferrer">X<Icon name="external" /></a>
        <a href="https://www.youtube.com/@hirokawabeach_283" target="_blank" rel="noopener noreferrer">YouTube<Icon name="external" /></a>
      </div>
    </aside>
  </section>

  <section class="section" aria-labelledby="projects-heading">
    <div class="section-head">
      <h2 id="projects-heading">制作物</h2>
      <a href="/projects/">すべて見る<Icon name="right" /></a>
    </div>
    <article class="spotlight" aria-label="制作物のハイライト" data-flip-preview>
      <div class="spotlight-preview">
        <div class="flip-stage" role="group" aria-label="作品を選択。左右キーでも切り替えられます">
          {projects.map((project, index) => (
            <button class="flip-window" type="button" data-flip-select={index} data-position={index} aria-pressed={index === 0} aria-controls={`project-preview-${index}`} disabled>
              <span class="flip-titlebar">{project.name}</span>
              <img src={project.image.src} alt="" width={project.image.width} height={project.image.height} loading="lazy" decoding="async" />
            </button>
          ))}
        </div>
        <div class="flip-controls" role="group" aria-label="作品を切り替える" hidden>
          <button type="button" data-flip-step="-1"><Icon name="left" />前の作品</button>
          <button type="button" data-flip-autoplay>一時停止</button>
          <button type="button" data-flip-step="1">次の作品<Icon name="right" /></button>
        </div>
        <span class="visually-hidden" role="status" aria-atomic="true" data-flip-status>StudyCoPi</span>
      </div>
      {projects.map((project, index) => (
        <div class="spotlight-copy" id={`project-preview-${index}`} data-flip-copy hidden={index !== 0}>
          <span class="spotlight-kind">{project.category}</span>
          <h3>{project.name}</h3>
          <p>{project.description}</p>
          <div class="spotlight-links">
            {project.href && <a href={project.href} target="_blank" rel="noopener noreferrer">公開サイト<Icon name="external" /></a>}
            {project.github && <a href={project.github} target="_blank" rel="noopener noreferrer">GitHub<Icon name="external" /></a>}
            {project.detail && <a href={project.detail}>使い方<Icon name="right" /></a>}
            <a href={project.image.src} target="_blank" rel="noopener noreferrer" aria-label={`${project.name}の画像を開く（新しいタブ）`}>画像を開く<Icon name="external" /></a>
          </div>
        </div>
      ))}
    </article>
  </section>

  <section class="blog-home" aria-labelledby="blog-heading">
    <div class="section-head">
      <h2 id="blog-heading">ブログ</h2>
      <a href="/blog/">記事一覧<Icon name="right" /></a>
    </div>
    <div class="post-list">
      {posts.map(post => <article class="post-row">
        <time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('ja-JP')}</time>
        <h2><a href={'/blog/' + post.id + '/'}>{post.data.title}<Icon name="right" /></a></h2>
        <p>{post.data.description}</p>
      </article>)}
    </div>
  </section>
</Base>

<script>
  document.querySelectorAll<HTMLElement>('[data-flip-preview]').forEach(preview => {
    const windows = [...preview.querySelectorAll<HTMLButtonElement>('[data-flip-select]')];
    const controls = preview.querySelector<HTMLElement>('.flip-controls');
    const panels = [...preview.querySelectorAll<HTMLElement>('[data-flip-copy]')];
    const status = preview.querySelector<HTMLElement>('[data-flip-status]');
    const autoplay = preview.querySelector<HTMLButtonElement>('[data-flip-autoplay]');
    if (!controls || !status || !autoplay || panels.length !== windows.length || windows.length < 2) return;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let current = 0;
    let playing = !reducedMotion.matches;
    let hovering = false;
    let visible = false;
    let timer: ReturnType<typeof setTimeout> | undefined;

    const select = (selected: number, announce = true) => {
      current = (selected + windows.length) % windows.length;
      windows.forEach((window, index) => {
        window.dataset.position = String((index - current + windows.length) % windows.length);
        window.setAttribute('aria-pressed', String(index === current));
      });
      panels.forEach((panel, index) => { panel.hidden = index !== current; });
      // Automatic advances must not repeatedly interrupt screen readers.
      status.setAttribute('aria-live', announce ? 'polite' : 'off');
      status.textContent = windows[current].textContent?.trim() ?? '';
    };

    const schedule = () => {
      clearTimeout(timer);
      autoplay.textContent = playing ? '一時停止' : '自動再生';
      autoplay.setAttribute('aria-label', playing ? '自動再生を一時停止' : '自動再生を開始');
      if (playing && !hovering && visible && !document.hidden) {
        timer = setTimeout(() => {
          select(current + 1, false);
          schedule();
        }, 5000);
      }
    };
    const manualSelect = (selected: number) => {
      playing = false;
      select(selected);
      schedule();
    };

    windows.forEach((button, index) => {
      button.disabled = false;
      button.addEventListener('click', () => manualSelect(index));
    });
    controls.querySelectorAll<HTMLButtonElement>('[data-flip-step]').forEach(button => {
      button.addEventListener('click', () => manualSelect(current + Number(button.dataset.flipStep)));
    });
    autoplay.addEventListener('click', () => {
      playing = !playing;
      schedule();
    });
    preview.addEventListener('pointerenter', event => {
      if (event.pointerType === 'touch') return;
      hovering = true;
      schedule();
    });
    preview.addEventListener('pointerleave', event => {
      if (event.pointerType === 'touch') return;
      hovering = false;
      schedule();
    });
    preview.addEventListener('focusin', event => {
      // A pointer click on the pause/play button must keep its original action.
      if (event.target === autoplay && !autoplay.matches(':focus-visible')) return;
      playing = false;
      schedule();
    });
    document.addEventListener('visibilitychange', schedule);
    reducedMotion.addEventListener('change', () => {
      if (reducedMotion.matches) playing = false;
      schedule();
    });
    const observer = new IntersectionObserver(entries => {
      visible = entries[0].isIntersecting;
      schedule();
    });
    observer.observe(preview);
    preview.addEventListener('keydown', event => {
      if (!(event.target instanceof HTMLElement) || !event.target.closest('button')) return;
      let next: number;
      switch (event.key) {
        case 'ArrowRight': next = current + 1; break;
        case 'ArrowLeft': next = current - 1; break;
        case 'Home': next = 0; break;
        case 'End': next = windows.length - 1; break;
        default: return;
      }
      event.preventDefault();
      manualSelect(next);
      windows[current].focus();
    });
    controls.hidden = false;
    schedule();
  });
</script>
