---
import Base from '../layouts/Base.astro';
const apiUrl = import.meta.env.PUBLIC_STATUS_API_URL ?? '';
---
<Base title="稼働状況" active="status">
  <header class="page-header">
    <div class="eyebrow">Homelab / System status</div>
    <h1 class="page-title">稼働状況</h1>
    <p>自宅のRaspberry Piから取得したリソース情報を表示するページです。</p>
  </header>
  <section class="status-board" aria-label="Raspberry Pi のステータス">
    <div class="status-head">
      <h2>Raspberry Pi</h2>
      <span class="connection" id="connection" role="status" aria-live="polite">接続準備中</span>
    </div>
    <dl class="metric-grid">
      <div class="metric"><dt>CPU使用率</dt><dd id="cpu">—</dd></div>
      <div class="metric"><dt>メモリ使用率</dt><dd id="memory">—</dd></div>
      <div class="metric"><dt>CPU温度</dt><dd id="temperature">—</dd></div>
      <div class="metric"><dt>稼働時間</dt><dd id="uptime">—</dd></div>
    </dl>
    <p id="updated" class="status-note" aria-live="polite">現在、計測データは公開していません。</p>
    <p class="status-note">※ このページには公開可能な利用率・温度等のみを掲載し、内部ネットワークや管理情報は表示しません。</p>
  </section>
  <script define:vars={{ apiUrl }}>
    const setText = (id, value) => {
      const node = document.getElementById(id);
      if (node) node.textContent = value;
    };
    const validNumber = (value, min, max) =>
      typeof value === 'number' && Number.isFinite(value) && value >= min && value <= max;
    async function refresh() {
      if (!apiUrl) return;
      try {
        const response = await fetch(apiUrl, { cache: 'no-store', signal: AbortSignal.timeout(8000) });
        if (!response.ok) throw new Error('API unavailable');
        const data = await response.json();
        if (!data || !validNumber(data.cpu, 0, 100) || !validNumber(data.memory, 0, 100)
          || !validNumber(data.temperature, -40, 150) || !validNumber(data.uptime, 0, 1e10)) {
          throw new Error('Invalid telemetry');
        }
        setText('cpu', data.cpu.toFixed(1) + '%');
        setText('memory', data.memory.toFixed(1) + '%');
        setText('temperature', data.temperature.toFixed(1) + '°C');
        const hours = Math.floor(data.uptime / 3600);
        setText('uptime', Math.floor(hours / 24) + '日 ' + (hours % 24) + '時間');
        setText('connection', 'オンライン');
        document.getElementById('connection')?.setAttribute('data-state','online');
        setText('updated', '最終更新: ' + new Date().toLocaleTimeString('ja-JP'));
      } catch {
        setText('connection', '取得できません');
        document.getElementById('connection')?.removeAttribute('data-state');
        ['cpu', 'memory', 'temperature', 'uptime'].forEach(id => setText(id, '—'));
        setText('updated', '現在の値を取得できませんでした。しばらくしてから再度ご確認ください。');
      }
    }
    refresh();
    if (apiUrl) setInterval(refresh, 60000);
  </script>
</Base>
