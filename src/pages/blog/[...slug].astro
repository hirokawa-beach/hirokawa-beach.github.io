---
import Icon from '../../components/Icon.astro';
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.description} active="blog" ogType="article">
  <article class="article prose">
    <header class="page-header">
      <h1 class="page-title">{post.data.title}</h1>
      <p class="article-date"><time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('ja-JP')}</time> · {post.data.tags.join(' / ')}</p>
    </header>
    <Content />
    <p style="margin-top: 45px"><a href="/blog/"><Icon name="left" />ブログ一覧に戻る</a></p>
  </article>
</Base>
