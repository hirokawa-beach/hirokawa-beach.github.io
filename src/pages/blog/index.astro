---
import Icon from '../../components/Icon.astro';
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<Base title="ブログ" description="開発の記録や、このサイトの更新について。" active="blog">
  <header class="page-header">
    <h1 class="page-title">ブログ</h1>
    <p>開発の記録や、このサイトの更新について。</p>
    <a class="text-link" href="/feed.xml">RSSフィード<Icon name="rss" /></a>
  </header>
  <div class="narrow post-list post-list--page">
    {posts.map(post => <article class="post-row">
      <time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('ja-JP')} · {post.data.tags.join(' / ')}</time>
      <h2><a href={'/blog/' + post.id + '/'}>{post.data.title}<Icon name="right" /></a></h2>
      <p>{post.data.description}</p>
    </article>)}
  </div>
</Base>
